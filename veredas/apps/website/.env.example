# ============================================================
# .env.example — Variáveis de ambiente
# Copie para .env.local e preencha com seus valores reais
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Obtenha em: https://supabase.com/dashboard → Settings → API

# URL do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Chave anônima (segura para expor no browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (NUNCA exponha — usar apenas no servidor)
# Usada para operações admin: criar usuários, bypass RLS, etc.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────

# URL pública do site (usado em links de e-mail / OAuth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── (Opcional) Analytics / Telemetry ─────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
